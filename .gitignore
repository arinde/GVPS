# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies — npm workspaces install into the root node_modules plus a
# node_modules per app for anything that can't be hoisted, so this has to
# match at any depth, not just the repo root.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js (apps/web)
.next/
out/

# nest build output (apps/api)
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
