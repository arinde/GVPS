# Neon. DATABASE_URL is the POOLED string (host contains "-pooler"), used at
# runtime. DIRECT_URL is for Prisma Migrate, which takes advisory locks the
# pooler does not support; if your project exposes no direct endpoint, point
# it at the pooled URL too — migrations work.
#
# Two query params are not optional in practice:
#   sslmode=require     Neon refuses plaintext connections.
#   connect_timeout=15  Neon scale-to-zero suspends idle computes. The default
#                       timeout is shorter than a cold start, so the first
#                       query after an idle period fails with P1001 and the
#                       next one succeeds. This is the fix for that.
# Strip channel_binding=require if Neon's console includes it — Prisma's
# driver does not support SCRAM channel binding.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/gvps?sslmode=require&connect_timeout=15"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/gvps?sslmode=require&connect_timeout=15"
PORT=3001
FRONTEND_ORIGIN="http://localhost:3000"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

# Seeds the first superadmin (see prisma/seed.ts) — registration is closed,
# so this is the only way in on a fresh database (FEATURES.md §1.6).
INITIAL_SCHOOL_NAME="GVPS"
INITIAL_SUPERADMIN_EMAIL="superadmin@example.com"
INITIAL_SUPERADMIN_PASSWORD="change-me-immediately"
