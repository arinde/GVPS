DATABASE_URL="postgresql://gvps:gvps@localhost:5432/gvps?schema=public"
PORT=3001
FRONTEND_ORIGIN="http://localhost:3000"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

# Seeds the first superadmin (see prisma/seed.ts) — registration is closed,
# so this is the only way in on a fresh database (FEATURES.md §1.6).
INITIAL_SCHOOL_NAME="GVPS"
INITIAL_SUPERADMIN_EMAIL="superadmin@example.com"
INITIAL_SUPERADMIN_PASSWORD="change-me-immediately"
